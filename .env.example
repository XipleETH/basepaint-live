# LiveKit Cloud project credentials. Keep LIVEKIT_API_SECRET server-side only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional Base RPC override used to verify BasePaint Brush ownership.
# The public Base endpoint is used when this is omitted.
BASE_RPC_URL=https://mainnet.base.org

# Supabase values will be used by the realtime chat integration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
